<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="760.0"
            styleClass="main-menu"
            stylesheets="@../styles/main.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.playlistlib.controller.LibraryController">

    <padding>
        <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
    </padding>

    <top>
        <VBox spacing="6.0">
            <Label styleClass="title" text="Library" />
            <Label styleClass="description" text="Browse your downloaded media and lists." />
            <Separator />
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.30" prefHeight="390.0">
            <items>
                <VBox minWidth="150.0" spacing="8.0">
                    <Label text="Lists" />
                    <ListView fx:id="listsView" prefWidth="190.0" VBox.vgrow="ALWAYS" />
                </VBox>

                <VBox minWidth="280.0" spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="selectedListLabel" styleClass="description"
                               text="No list selected" />
                        <Label fx:id="mediaCountLabel" text="0 media items" />
                    </HBox>
                    <TableView fx:id="mediaTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="titleColumn" prefWidth="230.0"
                                         text="Title" />
                            <TableColumn fx:id="durationColumn" prefWidth="85.0"
                                         text="Duration" />
                            <TableColumn fx:id="sourceColumn" prefWidth="130.0"
                                         text="Source" />
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <VBox spacing="8.0">
            <Separator />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label fx:id="statusLabel" maxWidth="1.7976931348623157E308"
                       text="Select a list to view its media." HBox.hgrow="ALWAYS" />
                <Button onAction="#refreshLibrary" text="Refresh" />
                <Button onAction="#goBack" text="← Back" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
